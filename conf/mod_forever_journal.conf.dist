[worldserver]

########################################
# mod-forever-journal
#
# Server half of the retail-style Journal addon. Its Dungeons and Raids tabs show every dungeon
# and raid with its bosses, their abilities, loot with drop chances and the instance's quests,
# plus the player's lockouts and entry requirements. Its Mounts, Pets and Toys tabs show every
# collectible and where it comes from. Its Quests tab lists every quest of the realm by zone,
# class, profession and world event. Its Lore tab is a codex of each zone's places, people and
# history that fills in as characters play. All of it is read from this realm's own data.
#
# The journal is built once at startup. Changes to Rares, EraLocks, the Loot.*, Collections.*
# and Quests.* options take effect after a restart, not after .reload config.
########################################

#
#    Journal.Enable
#        Description: Master switch. With 0 the addon tells players the journal isn't available.
#        Default:     1
#

Journal.Enable = 1

#
#    Journal.Rares
#        Description: List an instance's rare spawns (rare and rare elite creatures spawned in it)
#                     after its bosses.
#        Default:     1
#

Journal.Rares = 1

#
#    Journal.LearnAbilities
#        Description: Remember the spells journal bosses and their adds are seen casting
#                     (mod_forever_journal_learned), so abilities missing from the scripts show up
#                     after the first fights.
#        Default:     1
#

Journal.LearnAbilities = 1

#
#    Journal.EraLocks
#        Description: With mod-individual-progression (IndividualProgression.Enable = 1), mark
#                     instances and difficulties a character's progression stage hasn't opened as
#                     locked, the way IndividualProgression's teleport checks do. Locked content
#                     can still be browsed.
#        Default:     1
#

Journal.EraLocks = 1

#
#    Journal.Loot.WorldDropThreshold
#        Description: A reference loot table used by more loot tables than this is a world drop
#                     table (the "level 30-35 greens") and is left out of the boss loot.
#        Default:     25
#

Journal.Loot.WorldDropThreshold = 25

#
#    Journal.Loot.ShowWorldDrops
#        Description: Show world drop tables in the boss loot anyway (flagged as world drops).
#        Default:     0
#

Journal.Loot.ShowWorldDrops = 0

#
#    Journal.Loot.ShowPoorAndCommon
#        Description: List grey and white items too. Quest items and recipes are always listed.
#        Default:     0
#

Journal.Loot.ShowPoorAndCommon = 0

#
#    Journal.MaxQuestsPerInstance
#        Description: Most quests the Quests tab lists for one instance (5-200).
#        Default:     60
#

Journal.MaxQuestsPerInstance = 60

#
#    Journal.Collections.Enable
#        Description: The Mounts, Pets and Toys tabs: every mount, companion pet and toy, and its
#                     vendors, drops, quests, achievements, recipes and trainers.
#        Default:     1
#

Journal.Collections.Enable = 1

#
#    Journal.Collections.ShowUnobtainable
#        Description: Also list mounts, pets and toys nothing on the realm sells, drops or gives
#                     (promotions, removed and test items), marked unobtainable.
#        Default:     0
#

Journal.Collections.ShowUnobtainable = 0

#
#    Journal.Quests.Enable
#        Description: The Quests tab: every quest characters can be given, under the quest log's
#                     headings, with each character's progress and who gives the quest where.
#        Default:     1
#

Journal.Quests.Enable = 1

#
#    Journal.Directory.Enable
#        Description: The Directory tab: every friendly trainer, flight master, innkeeper, bank,
#                     auction house, mailbox, vendor and other service on the continents, nearest
#                     first, flagged on the map. The Town Guide spell and .find open it, and show
#                     a menu with the same search to characters without the addon. Turning it
#                     off works at a config reload; turning it on takes a restart.
#                     Replaces mod-npc-finder: never build both. They register the same .find
#                     command, and the worldserver stops at startup on the duplicate.
#        Default:     1
#

Journal.Directory.Enable = 1

#
#    Journal.Directory.SpellId
#        Description: The Town Guide spell (see tools/build_town_guide_patch.py). 0 leaves the
#                     spell out; .find still works.
#        Default:     90050
#

Journal.Directory.SpellId = 90050

#
#    Journal.Directory.LearnSpell
#        Description: Teach the Town Guide spell to every character at login (bots excepted).
#        Default:     1
#

Journal.Directory.LearnSpell = 1

#
#    Journal.Directory.MaxResults
#        Description: Most places one search or category lists (1-200).
#        Default:     60
#

Journal.Directory.MaxResults = 60

#
#    Journal.Directory.ResultsPerPage
#        Description: Places on one page of the gossip menu (1-25).
#        Default:     10
#

Journal.Directory.ResultsPerPage = 10

#
#    Journal.Directory.SaveZoneData
#        Description: Most spawns in a stock database have no zone. The first start works them
#                     out from the map files; with this on they're saved to the creature and
#                     gameobject tables so later starts read them back.
#        Default:     1
#

Journal.Directory.SaveZoneData = 1

#
#    Journal.Lore.Enable
#        Description: The Lore tab: a codex of each zone's places, people and history. Entries are
#                     discovered by exploring, talking to people, defeating them and doing quests
#                     (mod_forever_journal_lore and _lore_trigger in the world database), and each
#                     character's discoveries are kept in mod_forever_journal_lore_known. Takes a
#                     restart; .journal lore reload reads changed lore without one.
#        Default:     1
#

Journal.Lore.Enable = 1
